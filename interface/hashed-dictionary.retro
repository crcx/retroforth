# Enable/Disable Use of The Hashed Dictionary Searches

~~~
#5    'KERNEL:D:LOOKUP-COMPARATOR-OFFSET const
#8    'KERNEL:D:LOOKUP-KEY-OFFSET const
#2049 'NGA:OP:LICA const

:d:use-hashes (:-)
  &eq? &d:lookup KERNEL:D:LOOKUP-COMPARATOR-OFFSET - store
  [ d:hash fetch ] &d:lookup KERNEL:D:LOOKUP-KEY-OFFSET - store
  NGA:OP:LICA &d:lookup store
  @d:HashFunction &d:lookup n:inc store ;

:d:use-strings (:-)
  &s:eq? &d:lookup KERNEL:D:LOOKUP-COMPARATOR-OFFSET - store
  &d:name &d:lookup KERNEL:D:LOOKUP-KEY-OFFSET - store
  #0 &d:lookup store
  #0 &d:lookup n:inc store ;

'interface/hashed-dictionary.retro 'd:use-hashes  d:set-source
'interface/hashed-dictionary.retro 'd:use-strings d:set-source
~~~
