# Enable/Disable Use of The Hashed Dictionary Searches

~~~
:d:use-hashes (:-)
  &eq? &d:lookup #5 - store
  [ d:hash fetch ] &d:lookup #8 - store
  #2049 &d:lookup store
  &s:hash &d:lookup n:inc store ;

:d:use-strings (:-)
  &s:eq? &d:lookup #5 - store
  &d:name &d:lookup #8 - store
  #0 &d:lookup store
  #0 &d:lookup n:inc store ;

&d:hash !HashFunction

'interface/hashed-dictionary.retro 'd:use-hashes  d:set-source
'interface/hashed-dictionary.retro 'd:use-strings d:set-source
~~~
